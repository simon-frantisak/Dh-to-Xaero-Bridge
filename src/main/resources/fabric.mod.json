  },
  "mixins": ["dh-xaero-bridge.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.21.1",
    "java": ">=21",
    "xaeroworldmap": ">=1.40.0",
    "distanthorizons": ">=3.0.0"
  }
}
